<Window x:Class="wpfCopilator.ManualText"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wpfCopilator"
        mc:Ignorable="d"
        Title="ManualText" Height="450" Width="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition MaxWidth="290"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!--Заголовки-->
        <ScrollViewer Grid.Row="0" Grid.Column="0" VerticalScrollBarVisibility="Auto" Background="#E0E0E0">

            <StackPanel Orientation="Vertical">

                <Button x:Name ="button_FormulationProblem" Content="Постановка задачи" FontSize="14" Background="#E0E0E0" Click="Click_button"/>
                <Button x:Name ="button_Grammar" Content="Грамматика" FontSize="14" Background="#E0E0E0" Click="Click_button"/>
                <Button x:Name ="button_ClassificationGrammar" Content="Классификация грамматики" FontSize="14" Background="#E0E0E0" Click="Click_button"/>

                <Button x:Name ="button_MethodAnalysis" Content="Метод анализа" FontSize="14" Background="#E0E0E0" Click="Click_button"/>
                <Button x:Name ="button_DiagnosticsAndNeutralizationErrors" Content="Диагностика и нейтрализация ошибок" FontSize="14" Background="#E0E0E0" Click="Click_button"/>
                <Button x:Name ="button_TestCase" Content="Тестовый пример" FontSize="14" Background="#E0E0E0" Click="Click_button"/>

                <Button x:Name ="button_Bibliography" Content="Список литературы" FontSize="14" Background="#E0E0E0" Click="Click_button"/>
                <Button x:Name ="button_ProgramSourceCode" Content="Исходный код" FontSize="14" Background="#E0E0E0" Click="Click_button"/>

            </StackPanel>

        </ScrollViewer>

        <!--Контент-->
        <Frame x:Name="ContentFrame" Grid.Column="1" Grid.Row="0" NavigationUIVisibility="Hidden"/>

        <GridSplitter Grid.Column="0" Grid.Row="0" Width="5" Background="#E0E0E0"/>
    </Grid>
</Window>
